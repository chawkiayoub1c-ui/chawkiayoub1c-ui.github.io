rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دوال مساعدة =====
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ayoubchawki1c@gmail.com';
    }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    // رسالة جديدة: الحقول المسموحة فقط، والمرسل هو صاحب الحساب
    function validMsg() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.text is string && d.text.size() <= 1000
        && d.name is string && d.name.size() <= 100
        && d.createdAt == request.time
        && d.keys().hasOnly(['text','uid','name','createdAt','replyTo','audio','dur','fx','image','video','vpath'])
        && (!('replyTo' in d) || d.replyTo is map)
        && (!('audio' in d) || (d.audio is string && d.audio.size() < 800000))
        && (!('image' in d) || (d.image is string && d.image.size() < 300000))
        && (!('video' in d) || (d.video is string && d.video.matches('https://.*')))
        && (!('vpath' in d) || (d.vpath is string && d.vpath.size() < 300));
    }

    // تعديل مسموح لأي عضو: تفاعل (reactions) أو بلاغ (reports) باسمه فقط
    function reactOnly() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['reactions','reports'])
        && n.get('reactions', {}).diff(o.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
        && n.get('reports', {}).diff(o.get('reports', {})).affectedKeys().hasOnly([request.auth.uid])
        && n.get('reactions', {}).get(request.auth.uid, '').size() <= 8
        && n.get('reports', {}).get(request.auth.uid, true) == true;
    }

    // ===== المستخدمون =====
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','photo','custom','seen'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 60000));
    }

    // ===== المتصلون الآن =====
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['on','last','name'])
        && request.resource.data.on is bool
        && request.resource.data.last == request.time
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100));
    }

    // ===== الغرفة العامة (المجموعة اسمها public والرسائل وثائق فيها) =====
    match /public/{mid} {
      allow read: if signedIn();
      allow create: if signedIn() && validMsg();
      allow update: if signedIn() && reactOnly();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ===== المجموعات =====
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','members','createdBy','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      // الانضمام برمز الدعوة: يضيف نفسه فقط ولا يحذف أحدا
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid]);

      match /messages/{mid} {
        function isMember() { return request.auth.uid in get(docPath('groups', gid)).data.members; }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember() && validMsg();
        allow update: if signedIn() && isMember() && reactOnly();
        allow delete: if signedIn() && isMember() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ===== المحادثات الخاصة (المشرف لا يستطيع مسحها) =====
    match /dms/{did} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members','names'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && did == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members','names']);

      match /messages/{mid} {
        function inDm() { return request.auth.uid in get(docPath('dms', did)).data.members; }
        allow read: if signedIn() && inDm();
        allow create: if signedIn() && inDm() && validMsg();
        allow update: if signedIn() && inDm() && reactOnly();
        allow delete: if signedIn() && inDm() && resource.data.uid == request.auth.uid;
      }
    }

    // ===== المكالمات =====
    match /calls/{cid} {
      allow read: if signedIn() && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer'])
        && request.resource.data.status in ['ringing','active','declined','ended'];

      // مرشحات الاتصال (ICE). المتصل قد يكتبها قبل وصول وثيقة المكالمة للخادم، لذلك نسمح بالإنشاء إن لم تُوجد بعد
      match /{side}/{cand} {
        function party() {
          let c = get(docPath('calls', cid)).data;
          return request.auth.uid == c.caller || request.auth.uid == c.callee;
        }
        allow read: if signedIn() && (side == 'callerCandidates' || side == 'calleeCandidates') && party();
        allow create: if signedIn() && (side == 'callerCandidates' || side == 'calleeCandidates')
          && (!exists(docPath('calls', cid)) || party());
      }
    }

    // ===== غرف لعبة متاهة الأسلحة (game.html) — بدون تسجيل دخول، بيانات الاتصال فقط =====
    match /rooms/{code} {
      allow get: if true;      // الانضمام برمز الغرفة
      allow list: if false;    // منع سرد كل الغرف
      allow create: if code.size() == 5
        && request.resource.data.keys().hasOnly(['max','created'])
        && request.resource.data.max in [2, 4]
        && request.resource.data.created is number;
      allow update, delete: if false;

      match /peers/{pid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['offer'])
          && request.resource.data.offer is map
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() < 20000;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','full']);
        allow delete: if false;
      }
    }
  }
}
